# Copy this file to .env.release.local and fill in local release values.
# .env.release.local is ignored by git and must never be committed.

# Required for Developer ID signing and notarization.
TEAM_ID=
NOTARY_PROFILE=

# Required for bundle identifiers in release builds.
BUNDLE_ID_PREFIX=

# Required for Sparkle update signing.
SPARKLE_ACCOUNT=ed25519
SPARKLE_PUBLIC_ED_KEY=

# Optional: otherwise use the selected Xcode or an installed Xcode app.
# DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer

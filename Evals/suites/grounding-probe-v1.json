    {
      "id": "commerce.customers-alphabetical",
      "schemaFixture": "commerce",
      "question": "List customers in alphabetical order by name",
      "expected": {
        "decision": "sql",
        "requiredTables": [
          "public.customers"
        ],
        "requiredColumnBindings": [
          "public.customers.name"
        ],
        "goldenSQL": "SELECT id, name, email FROM public.customers ORDER BY name ASC",
        "semantic": {
          "comparisonMode": "ordered",
          "allowExtraCandidateColumns": true,
          "requiredColumns": [
            {
              "canonicalName": "name"
            }
          ],
          "negativeControls": [
            {
              "id": "reverse-alphabetical",
              "sql": "SELECT id, name, email FROM public.customers ORDER BY name DESC"
            }
          ]
        }
      }
    },
    {
      "id": "commerce.write-query-order-counts",
      "schemaFixture": "commerce",
      "question": "Write a query showing each customer's email and how many orders they have",
      "expected": {
        "decision": "sql",
        "requiredTables": [
          "public.customers",
          "public.orders"
        ],
        "requiredColumnBindings": [
          "public.customers.email",
          "public.orders.customer_id"
        ],
        "requiredOperations": [
          "count"
        ],
        "goldenSQL": "SELECT c.id, c.email, COUNT(o.id) AS order_count FROM public.customers AS c LEFT JOIN public.orders AS o ON o.customer_id = c.id GROUP BY c.id, c.email ORDER BY c.id",
        "semantic": {
          "comparisonMode": "unordered",
          "allowExtraCandidateColumns": true,
          "requiredColumns": [
            {
              "canonicalName": "email"
            },
            {
              "canonicalName": "order_count",
              "aliases": [
                "orders",
                "order_total",
                "orders_count",
                "number_of_orders",
                "count"
              ]
            }
          ],
          "negativeControls": [
            {
              "id": "inner-join-drops-customers-without-orders",
              "sql": "SELECT c.id, c.email, COUNT(o.id) AS order_count FROM public.customers AS c JOIN public.orders AS o ON o.customer_id = c.id GROUP BY c.id, c.email ORDER BY c.id"
            }
          ]
        }
      }
    },

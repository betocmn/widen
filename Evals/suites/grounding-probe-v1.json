    {
      "id": "support.agents-without-open-tickets",
      "schemaFixture": "support",
      "question": "List support agents without an assigned open ticket",
      "expected": {
        "decision": "sql",
        "requiredTables": [
          "public.support_agent",
          "public.support_ticket"
        ],
        "requiredColumnBindings": [
          "public.support_agent.id",
          "public.support_ticket.assignee_id",
          "public.support_ticket.status"
        ],
        "goldenSQL": "SELECT a.id, a.name FROM public.support_agent AS a LEFT JOIN public.support_ticket AS t ON t.assignee_id = a.id AND t.status = 'open' WHERE t.id IS NULL ORDER BY a.id",
        "semantic": {
          "comparisonMode": "unordered",
          "allowExtraCandidateColumns": true,
          "requiredColumns": [
            {
              "canonicalName": "id"
            },
            {
              "canonicalName": "name"
            }
          ],
          "negativeControls": [
            {
              "id": "opposite-null-filter",
              "sql": "SELECT a.id, a.name FROM public.support_agent AS a LEFT JOIN public.support_ticket AS t ON t.assignee_id = a.id AND t.status = 'open' WHERE t.id IS NOT NULL ORDER BY a.id"
            }
          ]
        }
      }
    },
    {

          "null-filter"
        ],
        "goldenSQL": "SELECT id, assignee_id, created_at FROM public.support_ticket WHERE status = 'open' AND first_response_at IS NULL ORDER BY id",
        "semantic": {
          "comparisonMode": "unordered",
          "allowExtraCandidateColumns": true,
          "requiredColumns": [
            {
              "canonicalName": "id"
            }
          ],
          "negativeControls": [
            {
              "id": "missing-open-status-filter",
              "sql": "SELECT id, assignee_id, created_at FROM public.support_ticket WHERE first_response_at IS NULL ORDER BY id"
            }
          ]
        }
      }

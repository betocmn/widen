{
  "name": "openrouter-smoke-v1",
  "version": "1",
  "cases": [
    {
      "id": "openrouter.simple-select",
      "schemaFixture": "openrouter-smoke",
      "question": "List user IDs and email addresses.",
      "expected": {
        "decision": "sql",
        "requiredTables": ["public.users"],
        "requiredColumnBindings": ["public.users.id", "public.users.email"]
      }
    },
    {
      "id": "openrouter.simple-aggregate",
      "schemaFixture": "openrouter-smoke",
      "question": "Count orders by status.",
      "expected": {
        "decision": "sql",
        "requiredTables": ["public.orders"],
        "requiredColumnBindings": ["public.orders.status"],
        "requiredOperations": ["count", "group"]
      }
    },
    {
      "id": "openrouter.clarification",
      "schemaFixture": "openrouter-smoke",
      "question": "Show performance.",
      "expected": {
        "decision": "clarify",
        "clarificationMustMentionAny": ["metric", "measure", "performance", "which"]
      }
    },
    {
      "id": "openrouter.mixed-case-quoted-identifier",
      "schemaFixture": "openrouter-smoke",
      "question": "List eventType values from the mixed-case UserEvents table.",
      "expected": {
        "decision": "sql",
        "requiredTables": ["public.UserEvents"],
        "requiredColumnBindings": ["public.UserEvents.eventType"]
      }
    },
    {
      "id": "openrouter.two-table-join",
      "schemaFixture": "openrouter-smoke",
      "question": "Show each user's email with their order IDs.",
      "expected": {
        "decision": "sql",
        "requiredTables": ["public.users", "public.orders"],
        "requiredColumnBindings": [
          "public.users.email",
          "public.users.id",
          "public.orders.user_id",
          "public.orders.id"
        ],
        "requiredOperations": ["join"]
      }
    }
  ]
